<%- include('../partials/head', { pageTitle: '회의록 서명 · 본인 선택' }) %>

<main class="max-w-xl mx-auto px-4 py-8">
  <div class="bg-white rounded-2xl shadow-sm border p-6 mb-4">
    <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
      <span class="badge badge-violet">로그인 불필요</span>
      <span>본인 이름만 선택하면 돼요</span>
    </div>
    <h1 class="text-base font-bold text-slate-700"><%= meeting.committee_name %></h1>
    <h2 class="text-2xl font-bold text-slate-900 mt-1"><%= meeting.title %> · 회의록 서명</h2>
    <% if (meeting.location) { %>
    <p class="text-sm text-slate-500 mt-2">📍 <%= meeting.location %></p>
    <% } %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border p-6">
    <% if (members.length === 0) { %>
      <div class="bg-slate-50 border text-slate-500 rounded-lg px-4 py-6 text-sm text-center">아직 서명 대상이 지정되지 않았습니다.<br>관리자에게 문의해주세요.</div>
    <% } else { %>
    <h3 class="font-bold text-slate-900 mb-1">✍️ 본인 이름을 선택해주세요</h3>
    <p class="text-xs text-slate-500 mb-4">이름을 누르면 회의록 확인 후 서명 화면으로 이동합니다.</p>

    <div class="space-y-2">
      <% members.forEach(m => { const tk = tokenByMember[m.id]; const done = signedSet.has(m.id); %>
        <a href="/sign/<%= tk %>" class="flex items-center justify-between border rounded-xl px-4 py-3 hover:bg-violet-50 hover:border-violet-300 transition-colors">
          <div>
            <span class="font-semibold text-slate-900"><%= m.name %></span>
            <% const _aff = [m.affiliation, m.role].filter(Boolean).join(' / '); %>
            <% if (_aff) { %><span class="text-xs text-slate-500 ml-1"><%= _aff %></span><% } %>
          </div>
          <% if (done) { %>
            <span class="badge badge-green">서명완료</span>
          <% } else { %>
            <span class="text-violet-600 text-sm font-medium">서명하기 →</span>
          <% } %>
        </a>
      <% }) %>
    </div>

    <p class="text-xs text-slate-400 mt-4 text-center">본인 이름을 선택해 서명해주세요.</p>
    <% } %>
  </div>
</main>
</body></html>
